# Copy to config/houchen_publish.env (mode 0600). Git-ignored — never commit.
# Houchen research library Obsidian publish — isolated from macro config/rest.env.
#
# Token: Obsidian → Settings → Local REST API → apiKey
HOUCHEN_PUBLISH_BASE_URL=https://127.0.0.1:27124
HOUCHEN_PUBLISH_API_TOKEN=<paste apiKey here>
HOUCHEN_PUBLISH_VAULT_PREFIX=Research/世界苦茶/
HOUCHEN_PUBLISH_TIMEOUT=15
# HOUCHEN_PUBLISH_DRY_RUN_ONLY=1   # optional; CLI still requires --apply gate
