# Copy to config/insight.env, chmod 600, and fill locally.
# The real file is gitignored; never put secrets in launchd plist/logs.

# --- Common tuning (all providers) ---
INSIGHT_TIMEOUT_SECONDS=90
INSIGHT_MAX_TOKENS=6000
INSIGHT_MAX_RETRIES=2
INSIGHT_MAX_INPUT_CHARS=80000

# ============================================================
# Provider selection: INSIGHT_PROVIDER = anthropic | deepseek | minimax
# Anthropic is the default if INSIGHT_PROVIDER is unset.
# minimax is the recommended fallback when the other two are unavailable.
# ============================================================

# --- Option A: Anthropic Messages API (default) ---
# INSIGHT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# INSIGHT_MODEL=claude-fable-5

# --- Option B: DeepSeek (OpenAI-compatible /chat/completions) ---
# INSIGHT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# INSIGHT_MODEL=deepseek-chat

# --- Option C: MiniMax (OpenAI-compatible /chat/completions) ---
# Recommended fallback when Anthropic/DeepSeek are rate-limited or the key
# is unavailable. Same response shape as DeepSeek; the hard validator is
# provider-agnostic so quality control does not weaken.
# INSIGHT_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# INSIGHT_MODEL=MiniMax-Text-01