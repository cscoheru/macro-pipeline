# Copy to config/houchen_analyze.env, chmod 600. Git-ignored.
# Houchen claim extraction ONLY — do not point at config/insight.env.

INSIGHT_TIMEOUT_SECONDS=120
INSIGHT_MAX_TOKENS=8000
INSIGHT_MAX_RETRIES=2
INSIGHT_MAX_INPUT_CHARS=120000

# Must match CLI: analyze --provider <name>
INSIGHT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
INSIGHT_MODEL=deepseek-chat

# --- or anthropic ---
# INSIGHT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# INSIGHT_MODEL=claude-fable-5

# --- or minimax ---
# INSIGHT_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# INSIGHT_MODEL=MiniMax-Text-01
