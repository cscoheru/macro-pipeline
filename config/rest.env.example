# Copy to config/rest.env and fill in. Auto-extracted from the Obsidian
# "Local REST API" plugin (vault settings → plugin data.json: apiKey / port).
# This file (rest.env) is git-ignored; never commit real tokens.
#
# vault_writer.VaultWriter() parses KEY=VALUE lines here.
OBSIDIAN_TOKEN=<paste apiKey from Local REST API plugin>
OBSIDIAN_PORT=27124
OBSIDIAN_INSECURE_PORT=27124
